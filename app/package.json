{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/backend/index.ts",
    "build": "bun build ./src/frontend/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/backend/index.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run src/backend/db/migrate.ts",
    "db:seed": "bun run src/backend/db/seed.ts",
    "db:reset": "rm -f src/backend/db/sqlite.db && bun run src/backend/db/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "mp3tag.js": "^3.14.1",
    "musicbrainz-api": "^0.27.1",
    "react": "^19",
    "react-dom": "^19",
    "youtube-mp3-downloader": "^0.7.11",
    "ytmusic-api": "^5.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.6"
  }
}
